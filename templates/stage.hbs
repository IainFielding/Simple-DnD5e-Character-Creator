{{!--
  The "stage": the main panel of both the creator and level-up windows (the right-hand side; the
  step list is rail.hbs). It's a fixed frame — a header (step title + "3 of 9"), a body, and a
  footer with the Back/Next/Create buttons — and the body swaps in whichever step is active.

  The data comes from the shell's _prepareContext(): `step` (the active step's context, including
  its own template path), `nav` (button state + hints), and the `isReview`/`loading` flags.

  For a junior: the one line doing the real work is the dynamic partial below —
  `{{> (lookup step "template") step}}` means "render the template named in step.template, passing
  it the step object". That's how one stage frame hosts every different step's markup.
--}}
<div class="creator-stage">
  {{#if loading}}
  <div class="creator-loading">
    <i class="fa-solid fa-spinner fa-spin-pulse"></i>
    <p>{{loadingLabel}}</p>
  </div>
  {{else}}
  {{!--
    The step's heading. It is always rendered now. It used to be suppressed on the pick steps
    (`.creator-stage:has(.creator-pick) .creator-stage-head { display: none }`) to reclaim the
    vertical space, which cost two things: the "Step 3 of 9" counter, on precisely the steps that
    make up most of the flow; and the h1 itself, so the heading hierarchy on those screens started
    at the h2 of whatever option happened to be selected.

    The counter has moved to the progress meter in the top bar, where it is visible on every step,
    so this band is now just the heading and a one-line instruction — small enough to keep.
    `instruction` is optional; steps that need no framing simply omit it.
  --}}
  <header class="creator-stage-head">
    <h1>{{heading.title}}</h1>
    {{#if heading.instruction}}<p class="creator-stage-instruction">{{heading.instruction}}</p>{{/if}}
  </header>

  <div class="creator-stage-body">
    {{> (lookup step "template") step}}
    {{#if sourceDetails}}{{> "modules/sogrom-dnd5e-character-creator/templates/parts/source-details.hbs" sourceDetails}}{{/if}}
    {{!-- The comparison grid shares this slot with the book page, and the shell guarantees only one
          of them is ever set — see _openCompare(). Both cover the stage body and nothing else, so
          the footer's Back/Next stay reachable underneath either. --}}
    {{#if compare}}{{> "modules/sogrom-dnd5e-character-creator/templates/parts/compare.hbs" compare}}{{/if}}
    {{!-- The entry screens share this slot too, and the shell guarantees only one overlay is ever
          set. They are the way IN to a build rather than a detour from one, so they sit here
          rather than replacing the step: the footer's Back/Next stay reachable underneath, and the
          dossier beside them fills in as the picks are made. --}}
    {{#if entry}}{{> "modules/sogrom-dnd5e-character-creator/templates/parts/entry-chooser.hbs" entry}}{{/if}}
    {{#if threshold}}{{> "modules/sogrom-dnd5e-character-creator/templates/parts/threshold.hbs" threshold}}{{/if}}
  </div>

  <footer class="creator-stage-foot">
    <button type="button" class="creator-btn creator-btn--lead" data-action="navBack" {{#unless nav.canBack}}disabled{{/unless}}>
      <span class="creator-btn-icon"><i class="fa-solid fa-arrow-left"></i></span>
      {{nav.backLabel}}
    </button>
    {{#if isReview}}
    {{#if finishHint}}<span class="creator-nav-hint" role="status"><i class="fa-solid fa-circle-info"></i>{{finishHint}}</span>{{/if}}
    {{else}}
    {{#if nav.hint}}<span class="creator-nav-hint" role="status"><i class="fa-solid fa-circle-info"></i>{{nav.hint}}</span>{{/if}}
    {{/if}}
    {{!-- The way back to the quick screen, for a player who left it to browse one category in
          full. Lives in the footer rather than in the step, so no step has to know that screen
          exists — the same reason the entry screens are overlays rather than steps. --}}
    {{#if quickReturn}}
    <button type="button" class="creator-btn creator-quick-return" data-action="entryReturn">
      <span class="creator-btn-icon"><i class="fa-solid fa-bolt"></i></span>
      {{quickReturn}}
    </button>
    {{/if}}
    {{!-- An entry screen lends the footer its own primary action: "Next" cannot mean anything on a
          screen that is not a step, and a permanently greyed Next beside a Create button inside
          the overlay was two controls for one decision. See #entryAction. --}}
    {{#if entryAction}}
    <button type="button" class="creator-btn creator-btn-primary creator-btn-finish"
            data-action="{{entryAction.action}}" {{#unless entryAction.enabled}}disabled{{/unless}}>
      {{entryAction.label}}
    </button>
    {{else if isReview}}
    <button type="button" class="creator-btn creator-btn-primary creator-btn-finish" data-action="finish" {{#unless canFinish}}disabled{{/unless}}>
      {{finishLabel}}
    </button>
    {{else}}
    <button type="button" class="creator-btn creator-btn-primary creator-btn--trail" data-action="navNext" {{#unless nav.canNext}}disabled{{/unless}}>
      {{nav.nextLabel}}
      <span class="creator-btn-icon"><i class="fa-solid fa-arrow-right"></i></span>
    </button>
    {{/if}}
  </footer>
  {{/if}}
</div>
