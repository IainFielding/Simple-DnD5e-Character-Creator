{{!--
  The entry chooser, and the ready-made list behind one of its answers.

  One template for both because they are one screen to the player — a question and the longer
  answer to its third option — and because they share the card shell and the art tiers. Which one
  renders is decided by `premades` being present in the context. Neither carries a Back of its own:
  that is the stage footer's, which knows to leave an entry screen before it tries to leave a step.

  Like source-details.hbs and compare.hbs, this covers the stage BODY only: the Back/Next footer
  stays reachable underneath, and the dossier beside it is untouched.

  Art comes in two tiers here, not three. `banner` is a journal scene from a book this world has;
  with no match there is no icon to fall back on (these are our own concepts, not compendium
  content), so the card wears our own frame and a sigil seeded from its id.
--}}
<div class="creator-entry" tabindex="-1">

  {{#if premades}}
  {{!-- ---------------------------------------------------------------- ready-made --}}
  {{!-- No heading here: it is in the stage's own band above, so the question is not asked twice. --}}
  {{#if premades.none}}
  <p class="creator-entry-empty">{{premades.none}}</p>
  {{else}}
  {{!-- The level filter, across every group. Offered only where the pregens span more than one
        level; built as the quick screen's level rungs are, so the two read as one control. --}}
  {{#if premades.levels}}
  <div class="creator-premade-levels" role="group"
       aria-label="{{localize "sogrom-dnd5e-character-creator.entry.premade.levelAria"}}">
    {{#each premades.levels}}
    <button type="button" class="creator-threshold-level{{#if this.active}} is-active{{/if}}"
            data-action="entryPremadeLevel" data-level="{{this.value}}"
            aria-pressed="{{this.active}}">{{this.label}}</button>
    {{/each}}
  </div>
  {{/if}}
  {{!-- Two groups, each labelled with where it came from. A player picking "Akra" is getting the
        system's own Akra, not our approximation of her, and the heading says so. --}}
  {{#each premades.groups}}
  <section class="creator-premade-group">
    <h3 class="creator-premade-grouphead">
      {{#if this.badge}}<img src="{{this.badge}}" alt="" aria-hidden="true">{{/if}}
      {{this.label}}
    </h3>
    <ul class="creator-premade-grid">
      {{#each this.entries}}
      <li>
        <button type="button" class="creator-premade{{#if this.chosen}} is-chosen{{/if}}"
                data-action="entryPremade" data-id="{{this.id}}"
                aria-pressed="{{#if this.chosen}}true{{else}}false{{/if}}">
          <span class="creator-premade-art">
            {{#if this.banner}}
            <img src="{{this.banner}}" alt="" loading="lazy">
            {{else if this.icon}}
            <img src="{{this.icon}}" alt="" loading="lazy" class="is-icon">
            {{else}}
            <canvas class="creator-sigil" data-seed="{{this.seed}}" aria-hidden="true"></canvas>
            {{/if}}
          </span>
          <span class="creator-premade-body">
            <span class="creator-premade-name">{{this.name}}</span>
            <span class="creator-premade-line">{{this.line}}</span>
            {{#if this.tagline}}<span class="creator-premade-tag">{{this.tagline}}</span>{{/if}}
          </span>
        </button>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/each}}
  {{/if}}

  {{!-- No buttons of its own. Back and Create are both the stage footer's — see _navBack and
        #entryAction. Selecting a card does not create anything; the footer's Create does, and it
        names who it is about to create, the one action in this window that cannot be undone from
        inside it. --}}

  {{else}}
  {{!-- ------------------------------------------------------------------- chooser --}}
  <ul class="creator-entry-paths">
    {{#each paths}}
    <li class="creator-entry-path{{#if this.lead}} is-lead{{/if}}">
      <span class="creator-entry-art{{#unless this.banner}} is-frame{{/unless}}">
        {{#if this.banner}}
        <img src="{{this.banner}}" alt="" loading="lazy">
        {{else}}
        <canvas class="creator-sigil" data-seed="{{this.seed}}" aria-hidden="true"></canvas>
        {{/if}}
        <span class="creator-entry-scrim">
          {{#if this.recommended}}<span class="creator-entry-kicker">{{this.recommended}}</span>{{/if}}
          <span class="creator-entry-title">{{this.title}}</span>
        </span>
      </span>
      <span class="creator-entry-body">
        <span class="creator-entry-tag">{{this.tagline}}</span>
        <ul class="creator-entry-points">
          {{#each this.points}}<li>{{this}}</li>{{/each}}
        </ul>
        {{!-- The lead path's button is styled off its `.is-lead` parent, not a class of its own. --}}
        <button type="button" class="creator-btn creator-entry-go"
                data-action="entryPath" data-path="{{this.id}}">{{this.go}}</button>
      </span>
    </li>
    {{/each}}
  </ul>

  {{/if}}
</div>
