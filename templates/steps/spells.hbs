{{!--
  The Spells step (creation): pick the cantrips and level-1 spells a spellcasting class knows. Two
  tabs (cantrips / level-1), a filterable list of the class's spells, and a running "picked" tally.
  A spellbook class (the Wizard) calls the level-1 tab "Spellbook" and gets a third, "Prepare",
  listing its book picks so the player can choose which are prepared.
  Non-casters get a short "nothing to choose" message instead (the {{else}} of `isSpellcaster`).
  Data from spells-step.mjs context(); clicking a spell fires data-action="pick-spell".
--}}
<section class="creator-pick creator-spells creator-spells-browser">
  {{#if isSpellcaster}}
  <!-- Main column: intro, tabs, filters, and the spell list for the active tab -->
  <div class="creator-pick-side">
    <p class="levelup-spells-intro">{{intro}}</p>
    {{#if prepareNote}}<p class="levelup-spells-intro">{{prepareNote}}</p>{{/if}}
    {{> "modules/sogrom-dnd5e-character-creator/templates/parts/spell-list-notice.hbs" this}}

    {{!-- With no list to draw from there is nothing behind any of these: the tabs would count
          toward a quota that cannot be filled, the filters would narrow an empty list, and the
          "choose 3 more" tally would contradict the panel above saying nothing can be chosen. The
          notice is the whole screen until it is answered. --}}
    {{#unless listMissing}}
    <div class="creator-spell-tabs">
      {{#if hasCantrips}}
      <button type="button" class="creator-spell-tab {{#if isCantripsTab}}is-active{{/if}} {{#if cantripsFull}}is-full{{/if}}"
              data-action="stepAction" data-step-action="spell-tab" data-tab="cantrips">
        {{localize "sogrom-dnd5e-character-creator.step.spells.cantrips"}}
        <span class="creator-spell-count">{{cantripCount}}/{{maxCantrips}}</span>
      </button>
      {{/if}}
      {{#if hasLevel1}}
      <button type="button" class="creator-spell-tab {{#if isLevel1Tab}}is-active{{/if}} {{#if spellsFull}}is-full{{/if}}"
              data-action="stepAction" data-step-action="spell-tab" data-tab="level1">
        {{#if isBook}}{{localize "sogrom-dnd5e-character-creator.step.spells.spellbookTab"}}{{else}}{{localize "sogrom-dnd5e-character-creator.step.spells.level1"}}{{/if}}
        <span class="creator-spell-count">{{spellCount}}/{{maxSpells}}</span>
      </button>
      {{/if}}
      {{#if isBook}}
      <button type="button" class="creator-spell-tab {{#if isPrepareTab}}is-active{{/if}} {{#if preparedTabFull}}is-full{{/if}}"
              data-action="stepAction" data-step-action="spell-tab" data-tab="prepare">
        {{localize "sogrom-dnd5e-character-creator.step.spells.prepareTab"}}
        <span class="creator-spell-count">{{preparedCount}}/{{maxPrepared}}</span>
      </button>
      {{/if}}
    </div>
    {{#if isPrepareTab}}<p class="levelup-spells-intro">{{localize "sogrom-dnd5e-character-creator.step.spells.prepareIntro" prepared=maxPrepared}}</p>{{/if}}

    <div class="creator-toolbar creator-toolbar--stacked">
      {{!-- No "Choose N more" here: the tab counts ("1/3") and the footer's hint already say it. --}}
      {{> "modules/sogrom-dnd5e-character-creator/templates/parts/spell-filters.hbs" showLevel=isLevel1Tab}}
    </div>

    <ul class="creator-picklist">
      {{#each list}}
      {{> "modules/sogrom-dnd5e-character-creator/templates/parts/spell-row.hbs" this compareCategory=../compareCategory}}
      {{else}}
      <p class="creator-empty">{{#if isPrepareTab}}{{localize "sogrom-dnd5e-character-creator.step.spells.prepareEmpty"}}{{else}}{{localize "sogrom-dnd5e-character-creator.step.spells.empty"}}{{/if}}</p>
      {{/each}}
    </ul>
    {{/unless}}

  </div>

  <!-- Sidebar: focused spell (scrolls), with the running tally pinned at the bottom -->
  <div class="creator-pick-desc">
    <div class="creator-pick-desc-scroll">
    {{#if focused}}
    <article class="creator-detail">
      {{> "modules/sogrom-dnd5e-character-creator/templates/parts/spell-detail-head.hbs" focused}}

      {{#if focused.granted}}
      {{!-- A spell an origin grants: say which, and offer nothing to press. --}}
      <p class="creator-swap-note"><i class="fa-solid fa-gift" aria-hidden="true"></i><span>{{focused.grantedNote}}</span></p>
      {{else if focused.prepareMode}}
      {{!-- The Prepare tab: the button prepares or unprepares the book pick instead of adding it. --}}
      <button type="button" class="creator-btn {{#if focused.prepared}}creator-btn-danger{{else}}creator-btn-primary{{/if}}"
              data-action="stepAction" data-step-action="toggle-prepared"
              data-uuid="{{focused.uuid}}"
              {{#if focused.prepareDisabled}}disabled{{/if}}>
        {{#if focused.prepared}}
        <i class="fa-solid fa-book"></i> {{localize "sogrom-dnd5e-character-creator.step.spells.unprepare"}}
        {{else}}
        <i class="fa-solid fa-book-open"></i> {{localize "sogrom-dnd5e-character-creator.step.spells.prepare"}}
        {{/if}}
      </button>
      {{else}}
      <button type="button" class="creator-btn {{#if focused.active}}creator-btn-danger{{else}}creator-btn-primary{{/if}}"
              data-action="stepAction" data-step-action="pick-spell"
              data-uuid="{{focused.uuid}}" data-level="{{focused.level}}"
              {{#if focused.disabled}}disabled{{/if}}>
        {{#if focused.active}}
        <i class="fa-solid fa-minus"></i> {{localize "sogrom-dnd5e-character-creator.step.spells.remove"}}
        {{else}}
        <i class="fa-solid fa-plus"></i> {{localize "sogrom-dnd5e-character-creator.step.spells.add"}}
        {{/if}}
      </button>
      {{/if}}

      <div class="creator-detail-body">{{{focused.description}}}</div>
    </article>
    {{else}}
    <div class="creator-pick-empty">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      <h2>{{localize "sogrom-dnd5e-character-creator.step.spells.label"}}</h2>
      <p>{{localize "sogrom-dnd5e-character-creator.step.spells.selectHint"}}</p>
    </div>
    {{/if}}
    </div>

    <!-- Running tally of everything picked so far, grouped by level. -->
    <div class="creator-spell-selected">
      <span class="creator-spell-selected-label">{{localize "sogrom-dnd5e-character-creator.step.spells.selected"}}</span>
      {{#if hasSelected}}
      <div class="creator-spell-groups">
        {{#if selectedCantrips.length}}
        <div class="creator-spell-group">
          <span class="creator-spell-group-label">{{localize "sogrom-dnd5e-character-creator.step.spells.cantrips"}}</span>
          <ul class="creator-spell-chips">
            {{#each selectedCantrips}}
            <li><a class="content-link creator-spell-chip" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{#if isBook}}
        {{!-- A book caster's picks, split the way they land on the sheet. --}}
        {{#if preparedChips.length}}
        <div class="creator-spell-group">
          <span class="creator-spell-group-label">{{localize "sogrom-dnd5e-character-creator.step.spells.groupPrepared"}}</span>
          <ul class="creator-spell-chips">
            {{#each preparedChips}}
            <li><a class="content-link creator-spell-chip" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{#if bookOnlyChips.length}}
        <div class="creator-spell-group">
          <span class="creator-spell-group-label">{{localize "sogrom-dnd5e-character-creator.step.spells.groupBookOnly"}}</span>
          <ul class="creator-spell-chips">
            {{#each bookOnlyChips}}
            <li><a class="content-link creator-spell-chip is-unprepared" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
        {{else if selectedSpells.length}}
        <div class="creator-spell-group">
          <span class="creator-spell-group-label">{{localize "sogrom-dnd5e-character-creator.step.spells.level1"}}</span>
          <ul class="creator-spell-chips">
            {{#each selectedSpells}}
            <li><a class="content-link creator-spell-chip" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
            {{/each}}
          </ul>
        </div>
        {{/if}}
      </div>
      {{else}}
      <span class="creator-spell-selected-empty">{{localize "sogrom-dnd5e-character-creator.step.spells.selectedNone"}}</span>
      {{/if}}

      {{!-- Spells the build grants outright — a Cleric's domain spells, a species cantrip. They are
            kept out of the list above (they can't be picked, and picking one would waste the slot),
            so they are shown here for reference: the player can see what they are getting without
            hunting for it on the Review. --}}
      {{#if hasGranted}}
      <div class="creator-spell-granted">
        <span class="creator-spell-group-label">
          <i class="fa-solid fa-gift" aria-hidden="true"></i>
          {{localize "sogrom-dnd5e-character-creator.step.spells.granted"}}
        </span>
        <ul class="creator-spell-chips">
          {{#each grantedCantrips}}
          <li><a class="content-link creator-spell-chip" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
          {{/each}}
          {{#each grantedSpells}}
          <li><a class="content-link creator-spell-chip" data-uuid="{{uuid}}" data-link data-tooltip="{{ccItemTooltip uuid}}"><img src="{{img}}" alt="">{{name}}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
    </div>
  </div>

  {{else}}
  <div class="creator-pick-empty creator-spells-none">
    <i class="fa-solid fa-ban"></i>
    <h2>{{localize "sogrom-dnd5e-character-creator.step.spells.label"}}</h2>
    <p>{{hint}}</p>
  </div>
  {{/if}}
</section>
