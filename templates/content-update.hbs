{{!--
  The "Update to new content" review page, rendered by scripts/content-update/update-app.mjs
  `ContentUpdateApp`. Items are grouped by what granted them (each class, species, background) or by
  kind (feats, spells, equipment). Read-only apart from three controls: a "Keep mine" box per item that looks
  customised (re-rehearses the update), the backup download / proceed-without-backup pair for a user
  who cannot create actors, and the Update / Cancel buttons. One root element: a scrolling body and
  the footer pinned below it, so the buttons stay in reach however long the review gets.
--}}
<section class="sogrom-cu-body">
  <div class="sogrom-cu-scroll">
  {{#if loading}}
  <p class="sogrom-cu-loading">
    <i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
    {{localize "sogrom-dnd5e-character-creator.contentUpdate.loading"}}
  </p>
  {{else if empty}}
  <p class="sogrom-cu-empty">
    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
    {{localize "sogrom-dnd5e-character-creator.contentUpdate.empty"}}
  </p>
  {{else if error}}
  <p class="sogrom-cu-callout is-error">{{localize "sogrom-dnd5e-character-creator.contentUpdate.failed"}}</p>
  <p class="sogrom-cu-error">{{error}}</p>
  {{else}}

  <p class="sogrom-cu-intro">{{localize "sogrom-dnd5e-character-creator.contentUpdate.intro"}}</p>

  {{#if hasRebuilt}}<p class="hint">{{localize "sogrom-dnd5e-character-creator.contentUpdate.rebuiltHint"}}</p>{{/if}}

  {{#if hasSources}}
  <ul class="sogrom-cu-sources">
    {{#each sources}}<li><i class="fa-solid fa-book" aria-hidden="true"></i> {{text}} <span class="hint">· {{count}}</span></li>{{/each}}
  </ul>
  {{/if}}

  <div class="sogrom-cu-which" role="group" aria-labelledby="sogrom-cu-which-title">
    <p class="sogrom-cu-which-title" id="sogrom-cu-which-title">{{localize "sogrom-dnd5e-character-creator.contentUpdate.which"}}</p>
    <div class="sogrom-cu-which-toggles">
      {{#each groups}}
      <label class="sogrom-cu-which-toggle checkbox{{#unless on}} is-off{{/unless}}">
        <input type="checkbox" data-action="category" data-category="{{key}}" {{#if on}}checked{{/if}} {{#if @root.recalculating}}disabled{{/if}}>
        {{label}} <span class="sogrom-cu-group-count">{{count}}</span>
      </label>
      {{/each}}
    </div>
    {{#if nothingToDo}}<p class="hint">{{localize "sogrom-dnd5e-character-creator.contentUpdate.nothingSelected"}}</p>{{/if}}
  </div>

  {{#each groups}}
  {{!-- Collapsed by default: the toggles above say what will change; open a heading for the detail. --}}
  <details class="sogrom-cu-group{{#unless on}} is-off{{/unless}}" data-group="{{key}}">
    <summary><h3><i class="fa-solid fa-chevron-right sogrom-cu-chevron" aria-hidden="true"></i>
      {{label}} <span class="sogrom-cu-group-count">{{count}}</span>
      {{#unless on}}<span class="sogrom-cu-tier is-skipped">{{localize "sogrom-dnd5e-character-creator.contentUpdate.notUpdating"}}</span>{{/unless}}</h3></summary>
    <ul class="sogrom-cu-items">
      {{#each items}}
      <li class="sogrom-cu-item">
        <img src="{{img}}" alt="" class="sogrom-cu-icon">
        <div class="sogrom-cu-item-text">
          <span class="sogrom-cu-item-head">
            <span class="sogrom-cu-item-name">{{name}}</span>
            {{#unless skipped}}<span class="sogrom-cu-tier is-{{tier}}">{{tierLabel}}</span>{{/unless}}
          </span>
          {{#if version}}<span class="sogrom-cu-version"{{#if versionTip}} data-tooltip="{{versionTip}}"{{/if}}>{{version}}</span>{{/if}}
          <span class="hint">{{groups}}{{#if matchedBy}} · {{matchedBy}}{{/if}}</span>
          {{#if customised}}
          <label class="sogrom-cu-keep checkbox" data-tooltip="{{localize "sogrom-dnd5e-character-creator.contentUpdate.keepTip"}}">
            <input type="checkbox" data-action="keep" data-item-id="{{id}}" {{#if keep}}checked{{/if}} {{#if skipped}}disabled{{/if}} {{#if @root.recalculating}}disabled{{/if}}>
            {{localize "sogrom-dnd5e-character-creator.contentUpdate.keep"}}
          </label>
          {{/if}}
          {{#if descriptionChanged}}
          <details class="sogrom-cu-desc" data-item-id="{{id}}">
            <summary>{{localize "sogrom-dnd5e-character-creator.contentUpdate.compareDescription"}}</summary>
            <div class="sogrom-cu-desc-cols">
              <div class="sogrom-cu-desc-col"><h4>{{localize "sogrom-dnd5e-character-creator.contentUpdate.yours"}}</h4>
                <div class="sogrom-cu-desc-text">{{{oldDescription}}}</div></div>
              <div class="sogrom-cu-desc-col"><h4>{{localize "sogrom-dnd5e-character-creator.contentUpdate.updated"}}</h4>
                <div class="sogrom-cu-desc-text">{{{newDescription}}}</div></div>
            </div>
          </details>
          {{/if}}
        </div>
      </li>
      {{/each}}
    </ul>
  </details>
  {{/each}}

  {{#if hasUntouched}}
  <h3>{{localize "sogrom-dnd5e-character-creator.contentUpdate.untouched"}}</h3>
  <ul class="sogrom-cu-untouched">
    {{#each untouched}}<li>{{name}} <span class="hint">({{reason}})</span></li>{{/each}}
  </ul>
  {{/if}}

  {{#if hasDecisions}}
  <h3>{{localize "sogrom-dnd5e-character-creator.contentUpdate.choices"}}</h3>
  {{#if toChooseNote}}<p class="sogrom-cu-callout">{{toChooseNote}}</p>{{/if}}
  <ul class="sogrom-cu-decisions">
    {{#each decisions}}
    <li class="is-{{status}}">
      <i class="fa-solid {{icon}}" aria-hidden="true"></i>
      <span class="sogrom-cu-decision-title">{{title}}</span>
      <span class="hint">{{host}}{{#if level}} · {{level}}{{/if}}</span>
      <span class="sogrom-cu-decision-status">{{statusLabel}}{{#if detail}}: {{detail}}{{/if}}</span>
    </li>
    {{/each}}
  </ul>
  {{/if}}

  <h3>{{localize "sogrom-dnd5e-character-creator.contentUpdate.beforeAfter"}}</h3>
  {{#if recalculating}}
  <p class="sogrom-cu-loading"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>
    {{localize "sogrom-dnd5e-character-creator.contentUpdate.recalculating"}}</p>
  {{/if}}
  {{#if hasRows}}
  <table class="sogrom-cu-diff">
    <thead><tr>
      <th></th>
      <th>{{localize "sogrom-dnd5e-character-creator.contentUpdate.before"}}</th>
      <th>{{localize "sogrom-dnd5e-character-creator.contentUpdate.after"}}</th>
    </tr></thead>
    <tbody>
      {{#each summary.rows}}<tr><th>{{label}}</th><td>{{before}}</td><td>{{after}}</td></tr>{{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="hint">{{localize "sogrom-dnd5e-character-creator.contentUpdate.noNumbers"}}</p>
  {{/if}}
  {{#if addedList}}<p><strong>{{localize "sogrom-dnd5e-character-creator.contentUpdate.added"}}</strong> {{addedList}}</p>{{/if}}
  {{#if removedList}}<p><strong>{{localize "sogrom-dnd5e-character-creator.contentUpdate.removed"}}</strong> {{removedList}}</p>{{/if}}

  <div class="sogrom-cu-backup">
    {{#if canCopy}}
    <p><i class="fa-solid fa-box-archive" aria-hidden="true"></i>
      {{localize "sogrom-dnd5e-character-creator.contentUpdate.backup.copy"}}</p>
    {{else}}
    <p class="sogrom-cu-callout">{{localize "sogrom-dnd5e-character-creator.contentUpdate.backup.noPermission"}}</p>
    <div class="sogrom-cu-backup-actions">
      <button type="button" data-action="download" class="creator-btn">
        <i class="fa-solid fa-download" aria-hidden="true"></i>
        {{localize "sogrom-dnd5e-character-creator.contentUpdate.backup.download"}}
      </button>
      {{#if downloaded}}<span class="sogrom-cu-downloaded"><i class="fa-solid fa-check" aria-hidden="true"></i>
        {{localize "sogrom-dnd5e-character-creator.contentUpdate.backup.downloaded"}}</span>{{/if}}
      <label class="checkbox">
        <input type="checkbox" data-action="skipBackup" {{#if skipBackup}}checked{{/if}}>
        {{localize "sogrom-dnd5e-character-creator.contentUpdate.backup.skip"}}
      </label>
    </div>
    {{/if}}
  </div>
  {{/if}}
  </div>

  <footer class="sogrom-cu-footer">
    <button type="button" data-action="cancel" class="creator-btn creator-btn-ghost">
      <i class="fa-solid fa-xmark" aria-hidden="true"></i> {{localize "sogrom-dnd5e-character-creator.contentUpdate.cancel"}}
    </button>
    {{#unless loading}}{{#unless empty}}{{#unless error}}
    <button type="button" data-action="update" class="creator-btn creator-btn-finish sogrom-cu-update" {{#if updateDisabled}}disabled{{/if}}>
      <i class="fa-solid {{#if working}}fa-spinner fa-spin{{else}}fa-arrows-rotate{{/if}}" aria-hidden="true"></i>
      {{localize "sogrom-dnd5e-character-creator.contentUpdate.update"}}
    </button>
    {{/unless}}{{/unless}}{{/unless}}
  </footer>
</section>
